{
    "name": "cscs/divi-course-image",
    "d4Shortcode": "cscs_divi_course_image",
    "title": "Course picture",
    "titles": "Course picture",
    "moduleClassName": "cscs_divi_field",
    "moduleOrderClassName": "cscs_divi_field_course_image",
    "moduleIcon": "divi/module-image",
    "category": "module",
    "folder": "cscs-courses",
    "attributes": {
        "module": {
            "type": "object",
            "selector": "{{selector}}",
            "settings": {
                "meta": {
                    "meta": []
                },
                "advanced": {
                    "text": [],
                    "html": []
                },
                "decoration": {
                    "layout": {
                        "groupType": "group-item",
                        "item": {
                            "groupSlug": "designLayout",
                            "priority": 10,
                            "render": true,
                            "component": {
                                "type": "group",
                                "name": "divi/layout",
                                "props": {
                                    "grouped": false
                                }
                            }
                        }
                    },
                    "background": [],
                    "filters": [],
                    "spacing": [],
                    "sizing": [],
                    "transform": [],
                    "animation": [],
                    "disabledOn": [],
                    "overflow": [],
                    "position": [],
                    "scroll": [],
                    "sticky": [],
                    "transition": [],
                    "zIndex": []
                }
            },
            "styleProps": {
                "layout": {
                    "selector": "{{selector}} .cscs-field"
                }
            }
        },
        "value": {
            "type": "object",
            "elementType": "content",
            "selector": "{{selector}} .cscs-field__value",
            "settings": {
                "decoration": {
                    "font": {
                        "groupType": "group-item",
                        "item": {
                            "groupSlug": "designValueText",
                            "priority": 10,
                            "render": true,
                            "component": {
                                "type": "group",
                                "name": "divi/font",
                                "props": {
                                    "attrName": "value.decoration.font",
                                    "grouped": true,
                                    "fieldLabel": "Value"
                                }
                            }
                        }
                    },
                    "spacing": {
                        "groupType": "group-item",
                        "item": {
                            "groupSlug": "designValueText",
                            "priority": 20,
                            "render": true,
                            "component": {
                                "type": "group",
                                "name": "divi/spacing",
                                "props": {
                                    "attrName": "value.decoration.spacing",
                                    "grouped": true,
                                    "fieldLabel": "Value"
                                }
                            }
                        }
                    }
                }
            }
        },
        "image": {
            "type": "object",
            "elementType": "image",
            "selector": "{{selector}} .cscs-field__image",
            "settings": {
                "decoration": {
                    "fit": [],
                    "border": [],
                    "boxShadow": []
                }
            },
            "styleProps": {
                "selector": "{{selector}} .cscs-field__image",
                "fit": {
                    "selector": "{{selector}} .cscs-field__image"
                },
                "border": {
                    "selector": "{{selector}} .cscs-field__image"
                },
                "boxShadow": {
                    "selector": "{{selector}} .cscs-field__image"
                }
            }
        },
        "field": {
            "type": "object",
            "selector": "{{selector}}",
            "settings": {
                "advanced": {
                    "source": {
                        "groupType": "group-item",
                        "item": {
                            "groupSlug": "content",
                            "attrName": "field.advanced.source",
                            "category": "configuration",
                            "priority": 10,
                            "render": true,
                            "features": {
                                "sticky": false,
                                "responsive": false,
                                "hover": false,
                                "preset": "content"
                            },
                            "label": "Source",
                            "description": "Which course or trainer this shows. Left empty it follows the page, which is what a theme builder template wants.",
                            "component": {
                                "name": "divi/select",
                                "type": "field",
                                "props": {
                                    "options": {}
                                }
                            }
                        }
                    },
                    "valueTag": {
                        "groupType": "group-item",
                        "item": {
                            "groupSlug": "content",
                            "attrName": "field.advanced.valueTag",
                            "category": "configuration",
                            "priority": 20,
                            "render": true,
                            "features": {
                                "sticky": false,
                                "responsive": false,
                                "hover": false,
                                "preset": "content"
                            },
                            "label": "Value element",
                            "description": "Which HTML element the value is.",
                            "component": {
                                "name": "divi/select",
                                "type": "field",
                                "props": {
                                    "options": {
                                        "div": {
                                            "label": "DIV"
                                        },
                                        "p": {
                                            "label": "P"
                                        },
                                        "span": {
                                            "label": "SPAN"
                                        },
                                        "strong": {
                                            "label": "STRONG"
                                        },
                                        "h2": {
                                            "label": "H2"
                                        },
                                        "h3": {
                                            "label": "H3"
                                        },
                                        "h4": {
                                            "label": "H4"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "imageSize": {
                        "groupType": "group-item",
                        "item": {
                            "groupSlug": "contentPicture",
                            "attrName": "field.advanced.imageSize",
                            "category": "configuration",
                            "priority": 30,
                            "render": true,
                            "features": {
                                "sticky": false,
                                "responsive": false,
                                "hover": false,
                                "preset": "content"
                            },
                            "label": "Size",
                            "description": "Which of the sizes WordPress made of this picture to serve. Larger is not better: a portrait shown at 300 pixels costs the visitor nothing extra if 300 pixels is what is sent.",
                            "component": {
                                "name": "divi/select",
                                "type": "field",
                                "props": {
                                    "options": {}
                                }
                            }
                        }
                    },
                    "imageAlt": {
                        "groupType": "group-item",
                        "item": {
                            "groupSlug": "contentPicture",
                            "attrName": "field.advanced.imageAlt",
                            "category": "configuration",
                            "priority": 40,
                            "render": true,
                            "features": {
                                "sticky": false,
                                "responsive": false,
                                "hover": false,
                                "preset": "content"
                            },
                            "label": "Alternative text",
                            "description": "What the picture says to somebody who cannot see it. Empty means the name of the course or trainer, which is usually right.",
                            "component": {
                                "name": "divi/text",
                                "type": "field"
                            }
                        }
                    },
                    "imageLink": {
                        "groupType": "group-item",
                        "item": {
                            "groupSlug": "contentPictureLink",
                            "attrName": "field.advanced.imageLink",
                            "category": "configuration",
                            "priority": 50,
                            "render": true,
                            "features": {
                                "sticky": false,
                                "responsive": false,
                                "hover": false,
                                "preset": "content"
                            },
                            "label": "Links to",
                            "description": "Where the picture takes a visitor who clicks it.",
                            "component": {
                                "name": "divi/select",
                                "type": "field",
                                "props": {
                                    "options": {
                                        "none": {
                                            "label": "Nowhere"
                                        },
                                        "post": {
                                            "label": "Its own page"
                                        },
                                        "file": {
                                            "label": "The picture at full size"
                                        },
                                        "custom": {
                                            "label": "An address of your own"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "imageLinkUrl": {
                        "groupType": "group-item",
                        "item": {
                            "groupSlug": "contentPictureLink",
                            "attrName": "field.advanced.imageLinkUrl",
                            "category": "configuration",
                            "priority": 60,
                            "render": true,
                            "features": {
                                "sticky": false,
                                "responsive": false,
                                "hover": false,
                                "preset": "content"
                            },
                            "label": "Address",
                            "description": "Used when the picture links to an address of your own.",
                            "component": {
                                "name": "divi/text",
                                "type": "field"
                            }
                        }
                    },
                    "imageLinkTarget": {
                        "groupType": "group-item",
                        "item": {
                            "groupSlug": "contentPictureLink",
                            "attrName": "field.advanced.imageLinkTarget",
                            "category": "configuration",
                            "priority": 70,
                            "render": true,
                            "features": {
                                "sticky": false,
                                "responsive": false,
                                "hover": false,
                                "preset": "content"
                            },
                            "label": "Open in a new window",
                            "description": "A new window is a surprise, so it is off unless somebody asks for it.",
                            "component": {
                                "name": "divi/toggle",
                                "type": "field"
                            }
                        }
                    },
                    "emptyText": {
                        "groupType": "group-item",
                        "item": {
                            "groupSlug": "content",
                            "attrName": "field.advanced.emptyText",
                            "category": "configuration",
                            "priority": 80,
                            "render": true,
                            "features": {
                                "sticky": false,
                                "responsive": false,
                                "hover": false,
                                "preset": "content"
                            },
                            "label": "When there is nothing to show",
                            "description": "Left empty the module disappears rather than printing a heading over a blank space.",
                            "component": {
                                "name": "divi/text",
                                "type": "field"
                            }
                        }
                    }
                }
            }
        },
        "css": {
            "type": "object"
        }
    },
    "settings": {
        "content": "auto",
        "design": "auto",
        "advanced": "auto",
        "groups": {
            "content": {
                "panel": "content",
                "priority": 10,
                "groupName": "content",
                "component": {
                    "name": "divi/composite",
                    "props": {
                        "groupLabel": "iSport"
                    }
                }
            },
            "contentPicture": {
                "panel": "content",
                "priority": 20,
                "groupName": "picture",
                "component": {
                    "name": "divi/composite",
                    "props": {
                        "groupLabel": "Picture"
                    }
                }
            },
            "contentPictureLink": {
                "panel": "content",
                "priority": 30,
                "groupName": "pictureLink",
                "component": {
                    "name": "divi/composite",
                    "props": {
                        "groupLabel": "Link"
                    }
                }
            },
            "designLayout": {
                "panel": "design",
                "priority": 5,
                "groupName": "designLayout",
                "component": {
                    "name": "divi/composite",
                    "props": {
                        "groupLabel": "Layout",
                        "clipboardCategory": "style",
                        "presetGroup": "divi/layout"
                    }
                }
            },
            "designValueText": {
                "panel": "design",
                "priority": 30,
                "groupName": "valueText",
                "multiElements": true,
                "component": {
                    "name": "divi/composite",
                    "props": {
                        "groupLabel": "Value text",
                        "clipboardCategory": "style"
                    }
                }
            }
        }
    }
}
