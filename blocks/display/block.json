{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "cscs/display",
	"title": "Courses and schedule",
	"category": "cscs",
	"icon": "calendar-alt",
	"description": "Shows a listing of courses or classes from iSport, configured by a display set.",
	"keywords": [ "isport", "courses", "schedule", "timetable" ],
	"textdomain": "course-schedule-connector",
	"supports": {
		"html": false,
		"align": [ "wide", "full" ],
		"spacing": { "margin": true, "padding": true }
	},
	"attributes": {
		"set": {
			"type": "string",
			"default": ""
		}
	},
	"editorScript": "cscs-block-editor",
	"style": "cscs",
	"editorStyle": "cscs"
}
