{
  "name": "course-schedule-connector",
  "version": "0.1.0",
  "description": "Display courses and class schedules from an iSport System installation in WordPress.",
  "license": "GPL-2.0-or-later",
  "author": "Lukas Pivonka <info@pivonka.co.uk>",
  "repository": {
    "type": "git",
    "url": "https://github.com/lukasista/wpdissi.git"
  },
  "private": true,
  "scripts": {
    "build": "wp-scripts build && npm run build:divi",
    "start": "wp-scripts start",
    "build:divi": "webpack --mode=production --config visual-builder/webpack.config.js",
    "start:divi": "webpack --mode=development --watch --config visual-builder/webpack.config.js",
    "lint:js": "wp-scripts lint-js",
    "lint:css": "wp-scripts lint-style",
    "format": "wp-scripts format",
    "makepot": "wp i18n make-pot . languages/course-schedule-connector.pot --exclude=node_modules,vendor,build,tests"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.25.0",
    "@babel/preset-react": "^7.25.0",
    "@wordpress/scripts": "^30.0.0",
    "babel-loader": "^9.2.0",
    "thread-loader": "^4.0.4",
    "webpack": "^5.95.0",
    "webpack-cli": "^7.2.2"
  }
}
